# Database
DATABASE_URL="postgresql://USER:***@HOST/DATABASE?sslmode=verify-full"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_API_KEY="replace-with-your-better-auth-infra-api-key"

# Email (Resend) — optional locally; without a key, emails are written to
# .email-outbox/ instead of being sent (see lib/email/transport.ts)
RESEND_API_KEY=""
EMAIL_FROM="SurfSync <onboarding@resend.dev>"
